// Windows resource for maxchat.exe — embeds the application icon (Explorer /
// taskbar / Alt-Tab) and version metadata (right-click ▸ Properties ▸ Details).
// Generated from maxchat.rc.in by CMake (@ONLY); the icon path and version
// resolve at configure time. Compiled by windres (MinGW) or rc (MSVC).
1 ICON "@MAXCHAT_ICON_PATH@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS 0x4L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "MaxChat Project"
      VALUE "FileDescription", "MaxChat - graphical IRC client"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "maxchat"
      VALUE "OriginalFilename", "maxchat.exe"
      VALUE "ProductName", "MaxChat"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "LegalCopyright", "Licensed under Apache-2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
